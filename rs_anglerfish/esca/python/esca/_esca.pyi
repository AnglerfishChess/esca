@final
class AnnotatedMove:
    """A legal move and its facts."""

    @property
    def move(self) -> Move: ...
    @property
    def facts(self) -> MoveFacts: ...

@final
class Facts:
    """Everything the v0 schema says about one position.

    Pickling re-reads the facts from the position they were computed for, so
    the history flags a game supplies do not survive a round trip.
    """

    def __new__(cls, fen: str, *, variant: Variant | None = None) -> Facts: ...
    @property
    def variant(self) -> Variant: ...
    @property
    def side_to_move(self) -> str: ...
    @property
    def position(self) -> Position: ...
    @property
    def state(self) -> StateFacts: ...
    @property
    def material(self) -> MaterialFacts: ...
    @property
    def pawns(self) -> PawnFacts: ...
    @property
    def pieces(self) -> PieceFacts: ...
    @property
    def king(self) -> KingFacts: ...
    @property
    def mobility(self) -> MobilityFacts: ...
    @property
    def attacks(self) -> AttackFacts: ...
    @property
    def tactics(self) -> tuple[TacticsFacts, TacticsFacts]: ...
    @property
    def planes(self) -> PlaneFacts: ...
    @property
    def moves(self) -> list[AnnotatedMove]: ...
    def summary(self) -> str: ...

@final
class Batch:
    """One batch of positions: their text, their features and their targets."""

    @property
    def fens(self) -> list[str]: ...
    @property
    def features(self) -> NDArray[np.float32]: ...
    @property
    def cp(self) -> NDArray[np.float32]: ...
    @property
    def mate(self) -> NDArray[np.float32]: ...
    @property
    def best_moves(self) -> list[Move]: ...
    def __len__(self) -> int: ...

@final
class Batches:
    """An iterator over the batches of an evaluation dump."""

    def __iter__(self) -> Batches: ...
    def __next__(self) -> Batch: ...

def encode(
    fens: Sequence[str],
    *,
    variant: Variant | None = None,
    schema: Schema | None = None,
    groups: Sequence[str] | None = None,
) -> NDArray[np.float32]: ...
def encode_into(
    fens: Sequence[str],
    out: NDArray[np.float32],
    *,
    variant: Variant | None = None,
    schema: Schema | None = None,
    groups: Sequence[str] | None = None,
) -> None: ...
def encode_moves(
    fen: str,
    *,
    variant: Variant | None = None,
) -> tuple[list[Move], NDArray[np.float32]]: ...
def features_for(variant: Variant, *, schema: Schema | None = None) -> list[tuple[str, str]]: ...
def schema() -> list[GroupInfo]: ...
def batches(
    path: str | os.PathLike[str],
    *,
    batch_size: int = 8192,
    min_depth: int = 0,
    variant: Variant | None = None,
    schema: Schema | None = None,
    groups: Sequence[str] | None = None,
) -> Batches: ...
