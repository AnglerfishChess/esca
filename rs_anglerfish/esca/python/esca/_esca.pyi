"""The compiled extension. Its public names are re-exported by `esca`."""

import os
from collections.abc import Iterator, Sequence
from typing import Final, TypedDict, final

import numpy as np
from numpy.typing import NDArray

__version__: Final[str]

CLASSIC: Final[Variant]
CHESS960: Final[Variant]

US: Final[int]
THEM: Final[int]

KING_TO_ROOK: Final[str]
KING_TWO_SQUARES: Final[str]

SCHEMA_V0: Final[Schema]
SCHEMA_ID: Final[str]
WIDTH: Final[int]
MOVE_WIDTH: Final[int]

class GroupInfo(TypedDict):
    """Where a schema group sits and how wide it is."""

    name: str
    version: int
    width: int
    offset: int

@final
class Variant:
    """One set of chess rules."""

    @staticmethod
    def named(name: str) -> Variant: ...
    @property
    def name(self) -> str: ...
    @property
    def promotion_roles(self) -> list[str]: ...
    def start_position(self, seed: int = 0) -> Position: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class SquareSet:
    """A set of squares, named `e4`-style."""

    def __new__(cls, squares: Sequence[str] | None = None) -> SquareSet: ...
    @property
    def bits(self) -> int: ...
    @property
    def squares(self) -> list[str]: ...
    def is_subset(self, other: SquareSet) -> bool: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __contains__(self, square: str) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __and__(self, other: SquareSet) -> SquareSet: ...
    def __or__(self, other: SquareSet) -> SquareSet: ...
    def __xor__(self, other: SquareSet) -> SquareSet: ...
    def __sub__(self, other: SquareSet) -> SquareSet: ...
    def __invert__(self) -> SquareSet: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Move:
    """One action: origin, destination, promotion role and kind."""

    def __new__(
        cls,
        origin: str,
        destination: str,
        promotion: str | None = None,
        kind: str = "quiet",
        is_capture: bool = False,
    ) -> Move: ...
    @property
    def origin(self) -> str: ...
    @property
    def destination(self) -> str: ...
    @property
    def promotion(self) -> str | None: ...
    @property
    def kind(self) -> str: ...
    @property
    def is_capture(self) -> bool: ...
    @property
    def is_castling(self) -> bool: ...
    @property
    def is_en_passant(self) -> bool: ...
    @property
    def uci(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Position:
    """Placement and state, with no rules attached."""

    @staticmethod
    def from_fen(fen: str) -> Position: ...
    @property
    def fen(self) -> str: ...
    @property
    def epd(self) -> str: ...
    @property
    def side_to_move(self) -> str: ...
    @property
    def castling_rights(self) -> str: ...
    @property
    def en_passant(self) -> str | None: ...
    @property
    def halfmove_clock(self) -> int: ...
    @property
    def fullmove_number(self) -> int: ...
    @property
    def clocks_known(self) -> bool: ...
    @property
    def in_check(self) -> bool: ...
    @property
    def occupied(self) -> SquareSet: ...
    @property
    def key(self) -> int: ...
    def piece_at(self, square: str) -> str | None: ...
    def by_role(self, role: str) -> SquareSet: ...
    def by_colour(self, colour: str) -> SquareSet: ...
    def by_piece(self, role: str, colour: str) -> SquareSet: ...
    def king_of(self, colour: str) -> str: ...
    def facts(self, variant: Variant | None = None) -> Facts: ...
    def mirrored(self) -> Position: ...
    def summary(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Game:
    """A variant, a start position and the moves played from it."""

    def __new__(cls, *, variant: Variant | None = None, seed: int = 0) -> Game: ...
    @staticmethod
    def from_fen(fen: str, *, variant: Variant | None = None) -> Game: ...
    @staticmethod
    def from_position(position: Position, *, variant: Variant | None = None) -> Game: ...
    @property
    def variant(self) -> Variant: ...
    @property
    def position(self) -> Position: ...
    @property
    def start_position(self) -> Position: ...
    @property
    def moves(self) -> list[Move]: ...
    @property
    def positions(self) -> list[Position]: ...
    @property
    def ply(self) -> int: ...
    @property
    def castling_output(self) -> str: ...
    @castling_output.setter
    def castling_output(self, style: str) -> None: ...
    def legal_moves(self) -> list[Move]: ...
    def annotated_moves(self) -> list[AnnotatedMove]: ...
    def play(self, mv: Move | str) -> None: ...
    def play_san(self, text: str) -> None: ...
    def undo(self) -> Move | None: ...
    def move_to_uci(self, mv: Move) -> str: ...
    def move_to_san(self, mv: Move) -> str: ...
    def outcome(self) -> str | None: ...
    def claims(self) -> list[str]: ...
    def repetitions(self) -> int: ...
    def facts(self) -> Facts: ...

@final
class Schema:
    """The versioned contract between the extractor and the net."""

    @property
    def id(self) -> str: ...
    @property
    def semver(self) -> str: ...
    @property
    def width(self) -> int: ...
    @property
    def feature_count(self) -> int: ...
    @property
    def group_names(self) -> list[str]: ...
    def groups(self) -> list[GroupInfo]: ...
    def width_of(self, groups: Sequence[str] | None = None) -> int: ...
    def features_for(self, variant: Variant) -> list[tuple[str, str]]: ...
    def canonical(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

